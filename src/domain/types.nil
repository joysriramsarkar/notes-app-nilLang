// src/domain/types.nil
// নীলাং নোট অ্যাপ — টাইপ ও কনস্ট্যান্ট সংজ্ঞায়ন

let CATEGORY_ALL = "all";
let CATEGORY_IMPORTANT = "important";
let CATEGORY_WORK = "work";
let CATEGORY_PERSONAL = "personal";
let CATEGORY_IDEAS = "ideas";
let CATEGORY_STUDY = "study";
let CATEGORY_TODO = "todo";
let CATEGORY_ARCHIVE = "archive";
let CATEGORY_TRASH = "trash";

// ক্যাটাগরি তালিকা ও আইকন
let getCategoryList = fn() {
    let list = [];
    list = append(list, {"id": "all", "name": "সকল নোট", "nameEn": "All Notes", "icon": "📑", "color": "#4A90E2"});
    list = append(list, {"id": "important", "name": "জরুরি / পিন্ড", "nameEn": "Important", "icon": "⭐", "color": "#F5A623"});
    list = append(list, {"id": "work", "name": "কাজের নোট", "nameEn": "Work", "icon": "💼", "color": "#7ED321"});
    list = append(list, {"id": "personal", "name": "ব্যক্তিগত", "nameEn": "Personal", "icon": "👤", "color": "#9013FE"});
    list = append(list, {"id": "ideas", "name": "আইডিয়া ও উদ্ভাবন", "nameEn": "Ideas", "icon": "💡", "color": "#50E3C2"});
    list = append(list, {"id": "study", "name": "শিক্ষা ও গবেষণা", "nameEn": "Study", "icon": "📚", "color": "#BD10E0"});
    list = append(list, {"id": "todo", "name": "চেকলিস্ট ও টাস্ক", "nameEn": "To-Do & Tasks", "icon": "✅", "color": "#00C48C"});
    list = append(list, {"id": "archive", "name": "আর্কাইভ", "nameEn": "Archive", "icon": "📦", "color": "#8E8E93"});
    list = append(list, {"id": "trash", "name": "ট্র্যাশ / মুছে ফেলা", "nameEn": "Trash", "icon": "🗑️", "color": "#FF3B30"});
    return list;
};

// রঙের তালিকা
let getColorPalette = fn() {
    let colors = [];
    colors = append(colors, {"id": "indigo", "name": "নীল / Indigo", "hex": "#4F46E5", "bg": "#1E1B4B"});
    colors = append(colors, {"id": "emerald", "name": "সবুজ / Emerald", "hex": "#10B981", "bg": "#064E3B"});
    colors = append(colors, {"id": "amber", "name": "হলুদ / Amber", "hex": "#F59E0B", "bg": "#78350F"});
    colors = append(colors, {"id": "rose", "name": "গোলাপী / Rose", "hex": "#F43F5E", "bg": "#881337"});
    colors = append(colors, {"id": "violet", "name": "বেগুনী / Violet", "hex": "#8B5CF6", "bg": "#4C1D95"});
    colors = append(colors, {"id": "cyan", "name": "আকাশি / Cyan", "hex": "#06B6D4", "bg": "#164E63"});
    return colors;
};

// একটি খালি নোট অবজেক্ট তৈরি
let createNote = fn(id, title, content, category, tags, color, priority, isPinned, isFavorite, checklist) {
    let now = time();
    return {
        "id": id,
        "title": title,
        "content": content,
        "category": category,
        "tags": tags,
        "color": color,
        "priority": priority,
        "isPinned": isPinned,
        "isFavorite": isFavorite,
        "isArchived": false,
        "isTrashed": false,
        "checklist": checklist,
        "createdAt": now,
        "updatedAt": now
    };
};
