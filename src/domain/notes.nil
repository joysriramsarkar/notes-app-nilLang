// src/domain/notes.nil
// নীলাং নোট অ্যাপ — কোর নোট ইঞ্জিন (Notes Engine)

import "./types.nil" as Types;
import "./checklist.nil" as Checklist;
import "./markdown.nil" as Markdown;
import "./storage.nil" as Storage;

// নতুন নোট ইঞ্জিন ইনস্ট্যান্স তৈরি
let createNotesEngine = fn() {
    let seed = Storage.getSeedNotes();
    return {
        "notes": seed,
        "activeNoteId": "note-1",
        "activeCategory": "all",
        "searchQuery": "",
        "selectedTag": "",
        "theme": "dark",
        "filePath": "notes.json"
    };
};

// নোট সংখ্যা
let getCount = fn(engine) {
    return len(engine["notes"]);
};

// নির্দিষ্ট আইডি দিয়ে নোট খোঁজা
let getNoteById = fn(engine, id) {
    let notes = engine["notes"];
    let i = 0;
    while (i < len(notes)) {
        if (notes[i]["id"] == id) {
            return notes[i];
        }
        i = i + 1;
    }
    return null;
};

// নতুন নোট যোগ করা
let addNote = fn(engine, title, content, category, tags, color, priority, isPinned, isFavorite, checklist) {
    let newId = "note-" + str(len(engine["notes"]) + 1) + "-" + str(time());
    let note = Types.createNote(newId, title, content, category, tags, color, priority, isPinned, isFavorite, checklist);
    let updatedNotes = append(engine["notes"], note);
    engine["notes"] = updatedNotes;
    engine["activeNoteId"] = newId;
    Storage.saveNotesToFile(updatedNotes, engine["filePath"]);
    return engine;
};

// বিদ্যমান নোট আপডেট করা
let updateNote = fn(engine, id, title, content, category, tags, color, priority, isPinned, isFavorite, checklist) {
    let notes = engine["notes"];
    let updatedList = [];
    let i = 0;
    let found = false;

    while (i < len(notes)) {
        let n = notes[i];
        if (n["id"] == id) {
            let updated = {
                "id": n["id"],
                "title": title,
                "content": content,
                "category": category,
                "tags": tags,
                "color": color,
                "priority": priority,
                "isPinned": isPinned,
                "isFavorite": isFavorite,
                "isArchived": n["isArchived"],
                "isTrashed": n["isTrashed"],
                "checklist": checklist,
                "createdAt": n["createdAt"],
                "updatedAt": time()
            };
            updatedList = append(updatedList, updated);
            found = true;
        } else {
            updatedList = append(updatedList, n);
        }
        i = i + 1;
    }

    if (found) {
        engine["notes"] = updatedList;
        Storage.saveNotesToFile(updatedList, engine["filePath"]);
    }
    return engine;
};

// নোট ডিলিট করা (মুছে ফেলা বা ট্র্যাশে পাঠানো)
let deleteNote = fn(engine, id) {
    let notes = engine["notes"];
    let updatedList = [];
    let i = 0;

    while (i < len(notes)) {
        let n = notes[i];
        if (n["id"] == id) {
            if (n["isTrashed"]) {
                // স্থায়ীভাবে মুছে ফেলা (Permanent Delete)
            } else {
                // সফট ডিলিট: ট্র্যাশে পাঠানো
                let trashed = {
                    "id": n["id"],
                    "title": n["title"],
                    "content": n["content"],
                    "category": n["category"],
                    "tags": n["tags"],
                    "color": n["color"],
                    "priority": n["priority"],
                    "isPinned": false,
                    "isFavorite": n["isFavorite"],
                    "isArchived": false,
                    "isTrashed": true,
                    "checklist": n["checklist"],
                    "createdAt": n["createdAt"],
                    "updatedAt": time()
                };
                updatedList = append(updatedList, trashed);
            }
        } else {
            updatedList = append(updatedList, n);
        }
        i = i + 1;
    }

    engine["notes"] = updatedList;
    if (len(updatedList) > 0) {
        engine["activeNoteId"] = updatedList[0]["id"];
    } else {
        engine["activeNoteId"] = "";
    }
    Storage.saveNotesToFile(updatedList, engine["filePath"]);
    return engine;
};

// পিন টগল করা
let togglePin = fn(engine, id) {
    let notes = engine["notes"];
    let updatedList = [];
    let i = 0;

    while (i < len(notes)) {
        let n = notes[i];
        if (n["id"] == id) {
            let updated = {
                "id": n["id"],
                "title": n["title"],
                "content": n["content"],
                "category": n["category"],
                "tags": n["tags"],
                "color": n["color"],
                "priority": n["priority"],
                "isPinned": !n["isPinned"],
                "isFavorite": n["isFavorite"],
                "isArchived": n["isArchived"],
                "isTrashed": n["isTrashed"],
                "checklist": n["checklist"],
                "createdAt": n["createdAt"],
                "updatedAt": time()
            };
            updatedList = append(updatedList, updated);
        } else {
            updatedList = append(updatedList, n);
        }
        i = i + 1;
    }

    engine["notes"] = updatedList;
    Storage.saveNotesToFile(updatedList, engine["filePath"]);
    return engine;
};

// ফেভারিট টগল করা
let toggleFavorite = fn(engine, id) {
    let notes = engine["notes"];
    let updatedList = [];
    let i = 0;

    while (i < len(notes)) {
        let n = notes[i];
        if (n["id"] == id) {
            let updated = {
                "id": n["id"],
                "title": n["title"],
                "content": n["content"],
                "category": n["category"],
                "tags": n["tags"],
                "color": n["color"],
                "priority": n["priority"],
                "isPinned": n["isPinned"],
                "isFavorite": !n["isFavorite"],
                "isArchived": n["isArchived"],
                "isTrashed": n["isTrashed"],
                "checklist": n["checklist"],
                "createdAt": n["createdAt"],
                "updatedAt": time()
            };
            updatedList = append(updatedList, updated);
        } else {
            updatedList = append(updatedList, n);
        }
        i = i + 1;
    }

    engine["notes"] = updatedList;
    Storage.saveNotesToFile(updatedList, engine["filePath"]);
    return engine;
};

// নোট ফিল্টারিং ও সার্চিং
let getFilteredNotes = fn(engine) {
    let notes = engine["notes"];
    let cat = engine["activeCategory"];
    let query = lower(trim(engine["searchQuery"]));
    let tag = engine["selectedTag"];

    let result = [];
    let i = 0;

    while (i < len(notes)) {
        let n = notes[i];
        let isMatch = true;

        // ট্র্যাশ বা আর্কাইভ চেক
        if (cat == "trash") {
            if (!n["isTrashed"]) { isMatch = false; }
        } else if (cat == "archive") {
            if (!n["isArchived"] || n["isTrashed"]) { isMatch = false; }
        } else {
            if (n["isTrashed"] || n["isArchived"]) { isMatch = false; }

            if (cat == "important") {
                if (!n["isPinned"] && !n["isFavorite"]) { isMatch = false; }
            } else if (cat != "all" && cat != "") {
                if (n["category"] != cat) { isMatch = false; }
            }
        }

        // ট্যাগ ফিল্টার
        if (isMatch && tag != "") {
            let hasTag = false;
            let t = 0;
            while (t < len(n["tags"])) {
                if (n["tags"][t] == tag) {
                    hasTag = true;
                }
                t = t + 1;
            }
            if (!hasTag) { isMatch = false; }
        }

        // সার্চ কুয়েরি ফিল্টার
        if (isMatch && query != "") {
            let inTitle = contains(lower(n["title"]), query);
            let inContent = contains(lower(n["content"]), query);
            if (!inTitle && !inContent) {
                isMatch = false;
            }
        }

        if (isMatch) {
            result = append(result, n);
        }
        i = i + 1;
    }

    // পিন্ড নোটগুলো শুরুতে রাখা (Sorting)
    let pinnedList = [];
    let unpinnedList = [];
    let r = 0;
    while (r < len(result)) {
        if (result[r]["isPinned"]) {
            pinnedList = append(pinnedList, result[r]);
        } else {
            unpinnedList = append(unpinnedList, result[r]);
        }
        r = r + 1;
    }

    let finalSorted = [];
    let p = 0;
    while (p < len(pinnedList)) {
        finalSorted = append(finalSorted, pinnedList[p]);
        p = p + 1;
    }
    let u = 0;
    while (u < len(unpinnedList)) {
        finalSorted = append(finalSorted, unpinnedList[u]);
        u = u + 1;
    }

    return finalSorted;
};

// সামগ্রিক পরিসংখ্যান (Analytics & Stats)
let getAnalytics = fn(engine) {
    let notes = engine["notes"];
    let total = len(notes);
    let active = 0;
    let pinned = 0;
    let favorites = 0;
    let archived = 0;
    let trashed = 0;
    let totalWords = 0;
    let totalChars = 0;
    let totalTodos = 0;
    let completedTodos = 0;

    let i = 0;
    while (i < total) {
        let n = notes[i];
        if (n["isTrashed"]) {
            trashed = trashed + 1;
        } else if (n["isArchived"]) {
            archived = archived + 1;
        } else {
            active = active + 1;
            if (n["isPinned"]) { pinned = pinned + 1; }
            if (n["isFavorite"]) { favorites = favorites + 1; }

            totalWords = totalWords + Markdown.countWords(n["title"]) + Markdown.countWords(n["content"]);
            totalChars = totalChars + len(n["title"]) + len(n["content"]);

            let checks = n["checklist"];
            let c = 0;
            while (c < len(checks)) {
                totalTodos = totalTodos + 1;
                if (checks[c]["completed"]) {
                    completedTodos = completedTodos + 1;
                }
                c = c + 1;
            }
        }
        i = i + 1;
    }

    let todoProgress = 0;
    if (totalTodos > 0) {
        todoProgress = (completedTodos * 100) / totalTodos;
    }

    return {
        "totalNotes": total,
        "activeNotes": active,
        "pinnedNotes": pinned,
        "favoriteNotes": favorites,
        "archivedNotes": archived,
        "trashedNotes": trashed,
        "totalWords": totalWords,
        "totalChars": totalChars,
        "totalTodos": totalTodos,
        "completedTodos": completedTodos,
        "todoProgress": todoProgress
    };
};
