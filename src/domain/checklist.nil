let createCheckItem = fn(id, text, completed) {
    return {"id": id, "text": text, "completed": completed};
};
let toggleCheckItem = fn(items, itemId) {
    let result = [];
    let i = 0;
    while (i < len(items)) {
        let item = items[i];
        if (item["id"] == itemId) {
            let updated = {"id": item["id"], "text": item["text"], "completed": !item["completed"]};
            result = append(result, updated);
        } else {
            result = append(result, item);
        }
        i = i + 1;
    }
    return result;
};
let addCheckItem = fn(items, text) {
    let nextId = "chk-" + str(len(items) + 1) + "-" + str(time());
    let newItem = createCheckItem(nextId, text, false);
    return append(items, newItem);
};
let removeCheckItem = fn(items, itemId) {
    let result = [];
    let i = 0;
    while (i < len(items)) {
        let item = items[i];
        if (item["id"] != itemId) {
            result = append(result, item);
        }
        i = i + 1;
    }
    return result;
};
let calcProgress = fn(items) {
    let total = len(items);
    if (total == 0) {
        return {"total": 0, "done": 0, "percent": 0, "progressBar": "[—]"};
    }
    let done = 0;
    let i = 0;
    while (i < total) {
        if (items[i]["completed"]) {
            done = done + 1;
        }
        i = i + 1;
    }
    let percent = done * 100 / total;
    let barTotal = 10;
    let filled = percent * barTotal / 100;
    let bar = "";
    let b = 0;
    while (b < barTotal) {
        if (b < filled) {
            bar = bar + "█";
        } else {
            bar = bar + "░";
        }
        b = b + 1;
    }
    return {"total": total, "done": done, "percent": percent, "progressBar": "[" + bar + "] " + str(percent) + "% (" + str(done) + "/" + str(total) + ")"};
};
let toMarkdown = fn(items) {
    let out = "";
    let i = 0;
    while (i < len(items)) {
        let item = items[i];
        let mark = "[ ]";
        if (item["completed"]) {
            mark = "[x]";
        }
        out = out + "- " + mark + " " + item["text"] + "\n";
        i = i + 1;
    }
    return out;
};
