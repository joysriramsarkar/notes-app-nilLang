import "../domain/theme.nil" as Theme;
let renderStatsView = fn(analytics) {
    let out = "";
    let border = "═";
    let b = "";
    let i = 0;
    while (i < 56) {
        b = b + border;
        i = i + 1;
    }
    out = out + Theme.ANSI_FG_BRIGHT_MAGENTA + "╔" + b + "╗\n" + Theme.ANSI_RESET;
    out = out + Theme.ANSI_BOLD + "║          📊 নীলাং নোটবুক পরিসংখ্যান ড্যাশবোর্ড           ║\n" + Theme.ANSI_RESET;
    out = out + Theme.ANSI_FG_BRIGHT_MAGENTA + "╠" + b + "╣\n" + Theme.ANSI_RESET;
    out = out + "║  📑 মোট নোট সংখ্যা:     " + str(analytics["totalNotes"]) + " টি\n";
    out = out + "║  🟢 সক্রিয় নোট:          " + str(analytics["activeNotes"]) + " টি\n";
    out = out + "║  📌 পিন্ড (Pinned):      " + str(analytics["pinnedNotes"]) + " টি\n";
    out = out + "║  ⭐ পছন্দের (Favorites):  " + str(analytics["favoriteNotes"]) + " টি\n";
    out = out + "║  📦 আর্কাইভকৃত:           " + str(analytics["archivedNotes"]) + " টি\n";
    out = out + "║  🗑️ ট্র্যাশে রয়েছে:        " + str(analytics["trashedNotes"]) + " টি\n";
    out = out + Theme.ANSI_DIM + "╟────────────────────────────────────────────────────────╢\n" + Theme.ANSI_RESET;
    out = out + "║  ✍️ সর্বমোট শব্দ:        " + str(analytics["totalWords"]) + " টি শব্দ\n";
    out = out + "║  🔤 সর্বমোট অক্ষর:       " + str(analytics["totalChars"]) + " টি ক্যারেক্টার\n";
    out = out + "║  ✅ সম্পন্ন টাস্ক:       " + str(analytics["completedTodos"]) + " / " + str(analytics["totalTodos"]) + " (" + str(analytics["todoProgress"]) + "%)\n";
    out = out + Theme.ANSI_FG_BRIGHT_MAGENTA + "╚" + b + "╝\n" + Theme.ANSI_RESET;
    return out;
};
let renderAlapStatsModal = fn(analytics, onClose) {
    return {"type": "Column", "position": "absolute", "top": "15%", "left": "25%", "width": 450, "background": "#1E293B", "borderRadius": 16, "padding": 24, "shadow": {"x": 0, "y": 8, "blur": 32, "color": "black", "opacity": 0.5}, "children": [{"type": "Row", "margin": {"bottom": 16}, "children": [{"type": "Text", "text": "📊 নীলাং নোটবুক পরিসংখ্যান", "fontSize": 18, "fontWeight": "bold", "color": "#F8FAFC", "grow": true}, {"type": "Button", "text": "✕", "variant": "ghost", "onClick": onClose}]}, {"type": "Column", "children": [{"type": "Text", "text": "📑 মোট নোট: " + str(analytics["totalNotes"]) + " টি", "color": "#CBD5E1"}, {"type": "Text", "text": "🟢 সক্রিয় নোট: " + str(analytics["activeNotes"]) + " টি", "color": "#10B981"}, {"type": "Text", "text": "📌 পিন্ড নোট: " + str(analytics["pinnedNotes"]) + " টি", "color": "#38BDF8"}, {"type": "Text", "text": "⭐ ফেভারিট: " + str(analytics["favoriteNotes"]) + " টি", "color": "#F59E0B"}, {"type": "Text", "text": "✍️ সর্বমোট শব্দ: " + str(analytics["totalWords"]) + " টি", "color": "#E2E8F0"}, {"type": "Text", "text": "✅ সম্পন্ন টাস্ক: " + str(analytics["completedTodos"]) + "/" + str(analytics["totalTodos"]) + " (" + str(analytics["todoProgress"]) + "%)", "color": "#34D399"}]}]};
};
